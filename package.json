{
  "name": "hiero-agent",
  "version": "0.2.1",
  "description": "Hiero: a personal agent workbench with an explicit state machine, objective verification and fail-closed Docker execution.",
  "license": "MIT",
  "keywords": ["agent", "state-machine", "hiero"],
  "type": "module",
  "bin": {
    "hiero": "dist/src/server.js"
  },
  "files": [
    "dist/src",
    "frontend/dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "build:frontend": "npm --prefix frontend run build",
    "prepack": "npm run build:frontend && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
